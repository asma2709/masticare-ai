# ==============================================================================
# MastiCare AI - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the project root and fill in your values.
# NEVER commit your real secrets to version control.

# Application Environment (development | production)
ENVIRONMENT=development

# Database Connection (defaults to backend/masticare.db if not specified)
# DATABASE_URL=sqlite:///./backend/masticare.db

# Authentication Secret (Generate a strong 32+ character random key in production)
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secure-random-jwt-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REMEMBER_ME_EXPIRE_DAYS=30

# Allowed CORS Origins (comma-separated for production domains)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# Google OAuth 2.0 Configuration
# ==============================================================================
# To enable real Google Sign-In:
# 1. Open Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Configure OAuth Consent Screen (User Type: External, Scopes: openid, email, profile)
# 3. Create Credentials -> OAuth 2.0 Client ID -> Web application
#    - Authorized JavaScript origins: http://localhost:5173, http://127.0.0.1:5173
# 4. Paste the generated Client ID below for both backend and frontend:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend API Endpoint (Optional: defaults to proxy or http://localhost:8000)
# VITE_API_URL=http://localhost:8000
