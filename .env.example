# ==============================================================================
# MastiCare AI - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development or configure in your deployment dashboards.
# NEVER commit real secret keys, private passwords, or tokens to version control.
#
# ------------------------------------------------------------------------------
# 1. BACKEND DEPLOYMENT (Render Web Service Environment Variables)
# ------------------------------------------------------------------------------
# Environment: 'production' for deployed Render app, 'development' for local
ENVIRONMENT=development

# Database URL:
# Defaults to SQLite in backend/masticare.db if not specified.
# In Render production with Managed PostgreSQL: postgresql://user:password@host/dbname
# DATABASE_URL=sqlite:///./backend/masticare.db

# Authentication Secrets:
# Generate a strong 32+ character random key in production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secure-random-jwt-secret-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REMEMBER_ME_EXPIRE_DAYS=30

# CORS Allowed Origins:
# Comma-separated list of exact web client origins.
# Render production value must include your exact Vercel frontend URL:
CORS_ORIGINS=https://masticare-ai-tztq.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Google OAuth 2.0 Backend Configuration:
# Set this in Render Environment Variables with your OAuth Client ID.
# (Note: Google Client Secret is NOT required because GIS ID-token verification is used)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Demo Account Configuration (Optional seed values):
# DEMO_ACCOUNT_PASSWORD=MastiDemo@2026
# DEMO_ACCOUNT_EMAIL=demo@masticare.io
# DEMO_ACCOUNT_NAME=Dr. Demo Veterinarian
# DEMO_ACCOUNT_ROLE=farm_manager

# ------------------------------------------------------------------------------
# 2. FRONTEND DEPLOYMENT (Vercel Project Environment Variables)
# ------------------------------------------------------------------------------
# Backend API Base URL:
# In Vercel production: https://masticare-ai.onrender.com
# In local development: http://localhost:8000
VITE_API_URL=https://masticare-ai.onrender.com

# Google Identity Services Client ID:
# Must match the Google Cloud Console OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
